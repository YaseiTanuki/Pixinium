# Public SEO configuration. Set this to the production canonical origin.
NEXT_PUBLIC_SITE_URL=https://pixinium.com
# Optional Google Search Console HTML verification token.
GOOGLE_SITE_VERIFICATION=
# Set true for non-production deployments outside Vercel; Vercel previews are excluded automatically.
SEO_NOINDEX=false

# Supabase: authentication and PostgreSQL application schemas.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only: Cloudflare R2, using the account endpoint without /bucket.
R2_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
R2_BUCKET_NAME=pixinium
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret
# Verify r2.dev public access and public custom domains are disabled before setting true.
R2_BUCKET_PRIVATE=false

# Supabase Postgres runtime: restricted roles via the Session pooler.
DATABASE_URL=postgresql://pixinium_runtime.your-project:password@your-region.pooler.supabase.com:5432/postgres?sslmode=require
# Maintenance only: keep owner credentials in .env.supabase-r2.local, outside runtime.
DATABASE_URL_UNPOOLED=
SUPABASE_PROJECT_REF=your-project
MIGRATION_TARGET_HOST=your-region.pooler.supabase.com

# Server-only privileged catalog writer for admin studio; never expose to browsers.
# Must read profiles/categories and write catalog content, including drafts under RLS.
CATALOG_ADMIN_DATABASE_URL=postgresql://pixinium_catalog_admin.your-project:password@your-region.pooler.supabase.com:5432/postgres?sslmode=require

# Optional server-side agent API. Use a restricted broker-only database login.
# Agent client URL/token belong in local/pixinium-agent/.env.local, not here.
AGENT_DATABASE_URL=
