# Supabase: authentication and data required by Supabase features.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only: S3-compatible object storage; keep the bucket PRIVATE.
AWS_ACCESS_KEY_ID=your-storage-access-key
AWS_SECRET_ACCESS_KEY=your-storage-secret
AWS_ENDPOINT_URL_S3=https://your-branch-storage-endpoint
AWS_REGION=your-storage-region
S3_ASSETS_BUCKET=assets

# Neon: website content. Keep database credentials server-side.
DATABASE_URL=postgresql://user:password@your-neon-pooler/database?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@your-neon-host/database?sslmode=require

# Server-only privileged catalog writer for admin studio; never expose to browsers.
# Must read profiles/categories and write catalog content, including drafts under RLS.
CATALOG_ADMIN_DATABASE_URL=postgresql://catalog-admin:password@your-neon-pooler/database?sslmode=require

# Optional agent upload API. Disabled until both values are configured.
# SHA-256 hex digest of a random bearer token (never the token itself).
AGENT_API_TOKEN_SHA256=
# Existing catalog.profiles ID whose current role is admin.
AGENT_API_ADMIN_ID=
